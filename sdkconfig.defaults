CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 本板 USB-C 直连芯片原生 USB-Serial-JTAG（设备管理器中是 VID_303A&PID_1001），
# 没有 CH343，UART0 的 GPIO11/12 也没接到 USB。
# 所以必须把 USB-Serial-JTAG 设为主控制台并关闭次级控制台：
# 否则日志走 UART0（无人接收）、而 REPL 若绑 UART0 则键盘输入也无人读取，
# 表现为"日志正常但命令一个字都发不进去"。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# NTP：srv_ntp 里配了 3 个服务器（aliyun / pool / windows），
# 默认只允许 1 个槽位，多配的会被 lwip 静默忽略，故开到 3 以便自动轮换
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=80
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FPS_STATS=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_THEME_DEFAULT_DARK=y
# 2048 / 贪吃蛇的分数与大号数字（14px 在 44px 格子里太小）
CONFIG_LV_FONT_MONTSERRAT_24=y
# SD 卡中文文件名：FAT 侧用 CP936(GBK)，VFS API 侧收发 UTF-8
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# ===== 字体 =====
# font_ui_14 的位图超过 1MB，20 位 bitmap_index 寻址不够，必须开大格式索引
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# ===== 小智 AI =====
# 官方服务地址（组件默认值，写出来方便以后换自建服务器）
CONFIG_XIAOZHI_OTA_URL="https://api.tenclass.net/xiaozhi/ota/"
# 系统时间统一由 srv_ntp / RTC 管，禁止组件拿服务端时间改系统时钟
CONFIG_XIAOZHI_SYNC_SYSTEM_TIME_FROM_SERVER=n
# mbedTLS 的分配改走 PSRAM：小智 HTTPS 握手在内部 RAM 里会分配失败
# （mbedtls_ssl_setup 返回 -0x8D = PSA_ERROR_INSUFFICIENT_MEMORY）
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# 组件音频任务栈：回调里要跑 Opus 解码，8192 偏紧；放 PSRAM 省内部 RAM
CONFIG_XIAOZHI_AUDIO_TASK_STACK_SIZE=16384
# CONFIG_XIAOZHI_AUDIO_TASK_ALLOC_STATIC is not set
CONFIG_XIAOZHI_AUDIO_TASK_ALLOC_DYNAMIC=y
CONFIG_XIAOZHI_STACK_IN_PSRAM=y

# LVGL 9.6 起 LV_ASSERT_HANDLER_INCLUDE 被标记弃用，只要它非空就会在
# lv_conf_internal.h 里抛 #warning；而 IDF 默认 -Werror=cpp 会把 #warning
# 当成编译错误。按 LVGL 的提示显式关掉这一条 warning。
CONFIG_LV_DISABLE_ASSERT_HANDLER_INCLUDE_WARNING=y

